# Compass backend (FastAPI). Copy to backend/.env and fill in. Real values never go in git.
#
# Build:  python -m venv .venv && .venv/bin/pip install -r backend/requirements.txt   (once, from the repo root)
# Start:  cd backend && ../.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
#         Run ONE worker (no --workers): the transit logger runs inside the process and the
#         app keeps its SQLite database and caches on local disk (compass.db, .cache/).
# Check:  curl http://localhost:8000/health

# --- BU API gateway (transit + dining). Without these the app still runs on cached data. ---
BU_BASE=
BU_API_KEY=
# Where the key goes: x-api-key (default) | bearer | query:<param> | none
BU_AUTH=x-api-key
# Optional bearer token; if set it is used instead of BU_API_KEY.
BU_TOKEN=

# --- Browser origins allowed to call this API (comma-separated, no trailing slash) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Set to 0 to turn off the 2-minute transit logger (e.g. for tests) ---
COMPASS_LOGGER=1

# --- BU course catalog database (PostgreSQL, READ-ONLY: the app only runs SELECTs, in a read-only session) ---
# Without these, or when the database is unreachable, the app uses its disk copy of the last successful read
# (backend/.cache/catalog_<term>.json), and only then the synthetic sample catalog (clearly labelled).
DB_ENGINE=postgres
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# 1 = require TLS (default)
DB_SSL=1
# Term to list: 2271 = Spring 2027 (default), 2268 = Fall 2026
CATALOG_TERM=2271

# --- Assignments due (Briefing page). Private calendar links; keep them secret. ---
# Blackboard: Calendar > gear (Settings) > Share calendar > Generate link, paste it here.
BLACKBOARD_ICS_URL=
# Gradescope has no calendar link of its own. Leave blank and add items by hand on the
# Briefing page, or paste any .ics link that has your Gradescope due dates.
GRADESCOPE_ICS_URL=

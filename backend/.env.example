# Compass backend (FastAPI). Copy to backend/.env and fill in. Real values never go in git.
#
# Build:  python -m venv .venv && .venv/bin/pip install -r backend/requirements.txt   (once, from the repo root)
# Start:  cd backend && ../.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
#         Run ONE worker (no --workers): the transit logger runs inside the process and the
#         app keeps its SQLite database and caches on local disk (compass.db, .cache/).
# Check:  curl http://localhost:8000/health

# --- BU API gateway (transit + dining). Without these the app still runs on cached data. ---
BU_BASE=
BU_API_KEY=
# Where the key goes: x-api-key (default) | bearer | query:<param> | none
BU_AUTH=x-api-key
# Optional bearer token; if set it is used instead of BU_API_KEY.
BU_TOKEN=

# --- Browser origins allowed to call this API (comma-separated, no trailing slash) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Set to 0 to turn off the 2-minute transit logger (e.g. for tests) ---
COMPASS_LOGGER=1

# --- NOT read by the app today. Only scripts/pull_catalog_db.py (and a future read-only
#     DbCatalogSource) use these. Leave blank unless you run that script. ---
# DB_ENGINE=
# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

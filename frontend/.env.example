# Compass frontend (Next.js). Copy to frontend/.env.local and fill in.
#
# NEXT_PUBLIC_* values are baked into the JavaScript at BUILD time, so set this before building.
#
# Build:  cd frontend && npm ci && npm run build
# Start:  cd frontend && npm run start -- -p 3000
#
# Public URL of the backend (no trailing slash). Must be listed in the backend's CORS_ORIGINS
# on the other side: set the backend's CORS_ORIGINS to THIS site's URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

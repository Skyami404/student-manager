# Compass frontend (Next.js). Copy to frontend/.env.local and adjust if needed.
# Both values are read when the app is BUILT (and by `next dev`), so set them before `npm run build`.
#
# Build:  cd frontend && npm ci && npm run build
# Start:  cd frontend && npm run start -- -p 3000

# Where the Next.js server forwards API calls. The browser calls the same-origin path /backend/...,
# and Next proxies it here, so no CORS setup or public backend port is needed.
# Default (if unset): http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000

# Optional. Leave blank to use the /backend proxy above. Set it to call a backend directly from the
# browser instead, e.g. https://api.example.com; then add this site's URL to the backend's CORS_ORIGINS.
NEXT_PUBLIC_API_URL=
